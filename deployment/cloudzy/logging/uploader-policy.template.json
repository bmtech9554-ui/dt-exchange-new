{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadApprovedDestinationProperties",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:GetBucketVersioning", "s3:GetBucketObjectLockConfiguration", "s3:GetBucketPublicAccessBlock", "s3:GetBucketPolicyStatus", "s3:GetReplicationConfiguration"],
      "Resource": "arn:aws:s3:::REPLACE_APPROVED_INDIA_BUCKET"
    },
    {
      "Sid": "AppendAndVerifyEncryptedLogVersions",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectRetention", "s3:GetObjectVersion", "s3:GetObjectRetention"],
      "Resource": "arn:aws:s3:::REPLACE_APPROVED_INDIA_BUCKET/dtexchange/*"
    },
    {
      "Sid": "NoDeletionOrRetentionBypass",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:BypassGovernanceRetention", "s3:PutObjectLegalHold", "s3:PutBucketPolicy", "s3:PutLifecycleConfiguration", "s3:PutReplicationConfiguration"],
      "Resource": ["arn:aws:s3:::REPLACE_APPROVED_INDIA_BUCKET", "arn:aws:s3:::REPLACE_APPROVED_INDIA_BUCKET/*"]
    }
  ]
}
