# Nonsecret configuration only. DO NOT start the API until production adapters are implemented and accepted.
NODE_ENV=production
APP_ENV=production
DEPLOYMENT_ENV=production
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=https://dtexchange.app,https://admin.dtexchange.app
API_PUBLIC_URL=https://api.dtexchange.app
ADMIN_PUBLIC_URL=https://admin.dtexchange.app
PUBLIC_SITE_URL=https://dtexchange.app
DT_BACKEND_URL=https://api.dtexchange.app/api/v1
APK_ALLOWED_ORIGINS=https://dtexchange.app
REFERRAL_INVITE_BASE_URL=https://dtexchange.app
MANUAL_DEPOSIT_REVIEW=true
MANUAL_PAYOUT=true
AUTOMATED_BLOCKCHAIN_CREDIT=false
AUTOMATED_PAYOUT=false
TRANSACTIONS_ENABLED=false
PAYOUTS_ENABLED=false
# Narrow manual activation must not implicitly enable unrelated owner writes.
OWNER_WALLET_ADJUSTMENTS_ENABLED=false
REFERRAL_REWARD_RELEASE_ENABLED=false
TRADING_ENABLED=false
DEPOSITS_ENABLED=false
PRIVATE_FINANCIAL_STORAGE=postgres-encrypted
ANDROID_UPDATE_ENFORCED=true
DEV_OTP_EXPOSE=false
DEBUG=false
API_DEBUG=false
ADMIN_DEBUG=false
DEMO_MODE=false
ALLOW_TEST_ENDPOINTS=false
MOCK_PROVIDER=false
QUEUE_PREFIX=dt-production
NOTIFICATION_QUEUE=dt-engagement
PG_POOL_MAX=10
# Fill only with reviewed provider integrations; environment labels cannot register an adapter.
OTP_PROVIDER=dvconnect
VERIFICATION_PROVIDER=
RATE_PROVIDER=
EMAIL_PROVIDER=
SMS_PROVIDER=
PUSH_PROVIDER=
SUPPORT_STORAGE_PROVIDER=
BLOCKCHAIN_NETWORK=mainnet
TRON_NETWORK=tron-mainnet
# Read-only corroboration is required before enabling manual deposit credits.
# Supply the reviewed HTTPS RPC endpoint and credential outside this checkout.
# This does not enable automatic credits or change any deployed configuration.
TRON_PROVIDER=tron-http
TRON_API_URL=
TRON_API_KEY=
TRON_USDT_CONTRACT=
TRON_REQUIRED_CONFIRMATIONS=20
MANUAL_COLLECTION_ADDRESS=
APK_RELEASE_PUBLIC_KEY_B64=
# Generated securely outside the checkout. PostgreSQL role is provisioned separately from dt_owner.
DATABASE_URL=
REDIS_URL=
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
DATA_ENCRYPTION_KEY=
LOOKUP_HASH_KEY=
OTP_HASH_KEY=
# Supply the inspected proxy subnet only; do not use 0.0.0.0/0.
TRUST_PROXY_CIDR=

# Manual-mode capabilities: enable only after credential and delivery validation.
AUTH_OTP_CHANNEL=sms
DVCONNECT_API_KEY_FILE=/run/app-secrets/DVCONNECT_API_KEY
IDENTITY_VERIFICATION_ENABLED=false
BANK_VERIFICATION_PROVIDER=manual-review
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_PUSH_ENABLED=false
SUPPORT_ATTACHMENTS_ENABLED=false
PRIVATE_FINANCIAL_STORAGE=postgres-encrypted
