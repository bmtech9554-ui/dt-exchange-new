NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generate a local password; never commit .env. Use URL encoding in DATABASE_URL.
POSTGRES_USER=dt_dev
POSTGRES_PASSWORD=
POSTGRES_DB=dt_exchange
DATABASE_URL=postgresql://dt_dev:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/dt_exchange
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:6379/0
TRADING_ENABLED=false
DEPOSITS_ENABLED=false
PAYOUTS_ENABLED=false
# Future external-provider and managed-key integration settings.
DATA_ENCRYPTION_KEY_ID=
KMS_ENDPOINT=
OTP_PROVIDER_API_KEY=
VERIFICATION_PROVIDER_API_KEY=
TRON_API_KEY=
CUSTODY_PROVIDER_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Phase 3. Generate unique LOCAL keys with: node scripts/setup-dev-env.mjs
# RSA PEM keys encoded as base64. Rotate with a planned overlap/migration before release.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
# Independent base64-encoded 32-byte keys. Back up securely; losing these loses data access.
DATA_ENCRYPTION_KEY=
LOOKUP_HASH_KEY=
OTP_HASH_KEY=
# dev/mock adapters are refused in production. Unconfigured providers fail closed.
OTP_PROVIDER=dev
DEV_OTP_EXPOSE=false
VERIFICATION_PROVIDER=mock
MOCK_VERIFICATION_DECISION=under_review
RATE_PROVIDER=mock
MOCK_USDT_INR_RATE=92.45000000

# Phase 4 chain opt-in. Phase 5 payouts have their own PAYOUTS_ENABLED gate.
TRANSACTIONS_ENABLED=false
TRON_PROVIDER=mock
TRON_NETWORK=tron-mock
TRON_API_URL=
TRON_INDEXER_URL=
TRON_USDT_CONTRACT=DT-MOCK-USDT-CONTRACT
TRON_REQUIRED_CONFIRMATIONS=20
BLOCKCHAIN_SCAN_INTERVAL=15000
ORDER_DEPOSIT_EXPIRY_SECONDS=1800
CHAIN_STALE_REVIEW_SECONDS=7200
# Optional local JSON fixture; forbidden for real-network providers.
TRON_MOCK_FIXTURE_FILE=
CUSTODY_PROVIDER=mock
CUSTODY_API_URL=
# Next.js server-only URL. HTTPS required for release operations.
DT_BACKEND_URL=http://localhost:4000/api/v1
# Provision admin through secure environment; never commit populated values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# Phase 5. Sandbox only until a reviewed production adapter is registered.
# All amounts below are integer INR minor units (paise).
PAYOUT_PROVIDER=mock
PAYOUT_API_URL=
PAYOUT_API_KEY=
PAYOUT_API_SECRET=
PAYOUT_WEBHOOK_SECRET=
PAYOUT_STATUS_POLL_INTERVAL=30000
PAYOUT_MAX_RETRIES=3
PAYOUT_RETRY_DELAY=5000
PAYOUT_MIN_AMOUNT=100
PAYOUT_MAX_AMOUNT=10000000
PAYOUT_DAILY_LIMIT=100000000
PAYOUT_BANK_COOLDOWN_SECONDS=86400
PAYOUT_STALE_SECONDS=3600
PAYOUT_FAILED_ATTEMPT_LIMIT=3
PAYOUT_BALANCE_WARNING_THRESHOLD=10000000

# Phase 6: development adapters only; bind audited vendor adapters before production.
PUSH_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
PUSH_PROJECT_ID=
PUSH_CREDENTIALS_FILE=
EMAIL_API_URL=
EMAIL_API_KEY=
SMS_API_URL=
SMS_API_KEY=
SUPPORT_STORAGE_PROVIDER=mock
SUPPORT_STORAGE_BUCKET=
SUPPORT_STORAGE_ENDPOINT=
SUPPORT_STORAGE_KEY=
NOTIFICATION_QUEUE=dt-engagement
# Referral reward amounts/rules are audited system_settings, not client values.
REFERRAL_INVITE_BASE_URL=
REFERRAL_ALLOW_SANDBOX=false
HEALTH_REQUIRE_WORKERS=false
METRICS_ENABLED=true
# Test infrastructure only; never point these at production.
PHASE6_POSTGRES_URL=
PHASE6_REDIS_URL=

# Phase 7: NODE_ENV=production always invokes a fail-closed registered-adapter gate.
# Staging uses NODE_ENV=development + DEPLOYMENT_ENV=staging with isolated mock credentials.
DEPLOYMENT_ENV=development
MOCK_PROVIDER=false
BLOCKCHAIN_NETWORK=mock
PG_POOL_MAX=10
SERVICE_NAME=dt-api
# Production: PostgreSQL sslmode=verify-full; Redis rediss:// + ACL authentication.
# *_FILE alternatives are loaded by backend/scripts/entrypoint.mjs before imports.
DATABASE_URL_FILE=
REDIS_URL_FILE=
JWT_PRIVATE_KEY_B64_FILE=
JWT_PUBLIC_KEY_B64_FILE=
DATA_ENCRYPTION_KEY_FILE=
LOOKUP_HASH_KEY_FILE=
OTP_HASH_KEY_FILE=
TRON_API_KEY=
TRON_API_KEY_FILE=
PAYOUT_API_KEY_FILE=
PAYOUT_API_SECRET_FILE=
PAYOUT_WEBHOOK_SECRET_FILE=
# Configure at deployment; do not commit filled secret values.
# New activity switches and maintenance mode live in operational_controls (migration 007).
# No env override bypasses missing production adapters.
# Restrict to the actual reverse-proxy subnet; never use a universal trust setting.
TRUST_PROXY_CIDR=
METRICS_HOST=127.0.0.1
METRICS_PORT=9108
ADMIN_ROLE=operations
ADMIN_BREAK_GLASS_APPROVED=
# Production migration operator records a verified encrypted backup checksum.
PRE_MIGRATION_BACKUP_SHA256=
# Default legacy prefix in dev; dt-staging/dt-production for those environments.
QUEUE_PREFIX=

# Phase 8 RC1. No configuration value can promote a provider to validated status.
DEBUG=false
API_DEBUG=false
ADMIN_DEBUG=false
DEMO_MODE=false
ALLOW_TEST_ENDPOINTS=false
# HTTPS test deployment only, used by the read-only acceptance probe.
STAGING_API_URL=
# Release mobile API_BASE_URL is a --dart-define, never a signing/API secret.
# See release/rc1.json and docs/phase8 for the blocked certification and evidence gates.

# Read-only TRON validation: existing transaction on an explicitly configured test network.
TRON_VALIDATION_TX_HASH=

# Final setup: APP_ENV is optional in development; production must agree with NODE_ENV/DEPLOYMENT_ENV.
APP_ENV=development
# Public configuration inventory only; no domain ownership is assumed.
API_PUBLIC_URL=
ADMIN_PUBLIC_URL=
PUBLIC_SITE_URL=
# Run backend/scripts/configuration-report.mjs for a value-free offline inventory.

# Initial manual operations profile (explicitly disable automated financial workers).
MANUAL_DEPOSIT_REVIEW=true
MANUAL_PAYOUT=true
AUTOMATED_BLOCKCHAIN_CREDIT=false
AUTOMATED_PAYOUT=false
# Set a verified receiving TRC20 address; no signing key is required by this API.
MANUAL_COLLECTION_ADDRESS=
PRIVATE_FINANCIAL_STORAGE=postgres-encrypted
# Exact owned HTTPS website origins; no wildcard, credentials, or third-party host.
APK_ALLOWED_ORIGINS=
# Public Ed25519 key only. Private attestation key stays in external release CI.
APK_RELEASE_PUBLIC_KEY_B64=
ANDROID_UPDATE_ENFORCED=true
# Keep historical automated provider variables for later audited cutover.
