{
  "name": "@dt/backend",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --env-file-if-exists=../.env dist/main.js",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "worker": "node --env-file-if-exists=../.env dist/blockchain-worker.js",
    "worker:payouts": "node --env-file-if-exists=../.env dist/payout-worker.js",
    "worker:engagement": "node --env-file-if-exists=../.env dist/engagement-worker.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "bullmq": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
